{
  "$schema": "https://design.dhruvchoudhary.com/schema/registry.json",
  "name": "dsgn",
  "homepage": "https://design.dhruvchoudhary.com",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "description": "cn() class-name merge helper used by every component in the registry.",
      "dependencies": ["clsx", "tailwind-merge"],
      "registryDependencies": [],
      "files": [
        { "path": "src/lib/utils.ts", "target": "lib/utils.ts", "type": "registry:lib" }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "description": "Button with variant/size props via class-variance-authority, a non-reflowing loading state, and asChild composition via Radix Slot.",
      "dependencies": ["class-variance-authority", "@radix-ui/react-slot"],
      "registryDependencies": ["utils"],
      "files": [
        { "path": "src/components/button/button.tsx", "target": "components/dsgn/button.tsx", "type": "registry:ui" }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "description": "Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter.",
      "dependencies": [],
      "registryDependencies": ["utils"],
      "files": [
        { "path": "src/components/card/card.tsx", "target": "components/dsgn/card.tsx", "type": "registry:ui" }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "description": "Badge with variant props via class-variance-authority.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        { "path": "src/components/badge/badge.tsx", "target": "components/dsgn/badge.tsx", "type": "registry:ui" }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "description": "Styled text input wrapping the native <input> element.",
      "dependencies": [],
      "registryDependencies": ["utils"],
      "files": [
        { "path": "src/components/input/input.tsx", "target": "components/dsgn/input.tsx", "type": "registry:ui" }
      ]
    }
  ]
}
