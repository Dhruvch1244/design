{
  "name": "@dhruvchoudhary/dsgn",
  "version": "0.1.1",
  "description": "CLI that copies dsgn design-system components into your project's own source tree — no runtime dependency on this package, in the shadcn/ui tradition. Works in any React + Tailwind project.",
  "type": "module",
  "bin": {
    "dsgn": "bin/dsgn.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "license": "MIT",
  "author": "Dhruv Choudhary",
  "homepage": "https://design.dhruvchoudhary.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvch1244/design.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/dhruvch1244/design/issues",
  "keywords": [
    "design-system",
    "components",
    "cli",
    "shadcn",
    "tailwind",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
